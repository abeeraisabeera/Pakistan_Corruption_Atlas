ENVIRONMENT=development
USE_SQLITE=true
SEED_ON_STARTUP=true
REPLACE_SEED_ON_STARTUP=true
SAMPLE_DATA_PATH=../data/sample/scandals.json
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=["localhost","127.0.0.1","test","testserver","*"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SEARCH=60
RATE_LIMIT_EXPORT=10
MAX_QUERY_LENGTH=200
MAX_PAGE_SIZE=100
EXPORT_MAX_ROWS=5000
DISABLE_DOCS=false
LOG_LEVEL=INFO

# Vercel API project (Root Directory = api):
# USE_SQLITE=false
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require
# SEED_ON_STARTUP=false
# REPLACE_SEED_ON_STARTUP=false
# TRUSTED_HOSTS=["*"]
# CORS_ORIGINS=["https://your-frontend.vercel.app"]
# ENVIRONMENT=development
