ENVIRONMENT=development
USE_SQLITE=true
SEED_ON_STARTUP=true
REPLACE_SEED_ON_STARTUP=true
SAMPLE_DATA_PATH=../ppca-export.json
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=["localhost","127.0.0.1","test","testserver","*.hf.space","*.huggingface.co"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SEARCH=60
RATE_LIMIT_EXPORT=10
MAX_QUERY_LENGTH=200
MAX_PAGE_SIZE=100
EXPORT_MAX_ROWS=5000
DISABLE_DOCS=false
LOG_LEVEL=INFO
# API_KEY_HASHES=["$argon2id$..."]
# API_KEY_PEPPER=
# REQUIRE_API_KEY_FOR_EXPORT=false
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCE_ON_EXPORT=false
# SENTRY_DSN=
# Production example:
# ENVIRONMENT=production
# USE_SQLITE=false
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require
# (sslmode is stripped automatically; asyncpg uses SSL via connect_args)
# SEED_ON_STARTUP=false
# DISABLE_DOCS=true
# CORS_ORIGINS=["https://your-app.vercel.app"]
